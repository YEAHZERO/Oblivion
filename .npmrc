# DSH 插件工作区的 pnpm 约定（与 DSH Profile 的规则保持一致）
#
# 1) 框架包（@deepseek-ai/*）只放 peerDependencies，绝不放 dependencies ——
#    否则 pnpm 会把宿主的框架包真拷贝一份，运行时出现两个模块实例，
#    symbol 身份分裂（TOOL_RUNTIME_SCHEDULER 之类）会让工具调用直接崩。
#    配套把 auto-install-peers 关掉，让 pnpm 不去「补装」这些 peer。
auto-install-peers=false

# 2) peer 版本不满足时只警告、不阻断（宿主提供的版本由 DSH 决定，不由工作区决定）。
strict-peer-dependencies=false

# 3) 未声明就 import 的包一律解析失败（默认值，显式写出来当规范）：
#    插件必须显式声明依赖，不允许"碰巧能 require 到"。
hoist=false
