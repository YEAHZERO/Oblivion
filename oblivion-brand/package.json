{
  "name": "@oblivion/brand",
  "version": "0.1.0",
  "description": "Oblivion 品牌插件：把 DSH 侧栏与会话 Hero 的品牌换成北极星；品牌名文字可在设置中自定义；并可把插件市场面板挂到侧栏「插件」下方。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compat": {
      "host": ">=0.2.0-rc.2 <0.3.0",
      "requires": {
        "services": [
          "slots"
        ],
        "slots": [
          "sidebar.brand.mark",
          "sidebar.brand.name",
          "conversation.hero.brand.mark",
          "sidebar.panellist",
          "main"
        ],
        "slotKinds": {
          "sidebar.brand.mark": "single",
          "sidebar.brand.name": "single",
          "conversation.hero.brand.mark": "single",
          "sidebar.panellist": "list",
          "main": "keyed"
        },
        "clientContract": [
          "__ModuleLoader__"
        ]
      }
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "VERSION",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "version:bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
