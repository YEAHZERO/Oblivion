{
  "name": "@oblivion/panel",
  "version": "0.0.11",
  "description": "Oblivion 认知面板：把 @oblivion/core 的捕获率、拦截原因、调参建议与最近沉淀嵌进 dsh-better-sidebar 的一列里。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./testkit": "./lib/testkit.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "compat": {
      "host": ">=0.2.0-rc.2 <0.3.0",
      "requires": {
        "slots": [
          "sidebar.footer.action"
        ],
        "slotKinds": {
          "sidebar.footer.action": "list"
        },
        "services": [
          "webServer"
        ],
        "npmPackages": [
          "dsh-better-sidebar"
        ],
        "clientContract": [
          "__ModuleLoader__"
        ]
      }
    }
  },
  "files": [
    "lib",
    "dshx.yml",
    "cordis.patch.yml",
    "README.md",
    "VERSION"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "selfcheck": "node scripts/selfcheck.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
