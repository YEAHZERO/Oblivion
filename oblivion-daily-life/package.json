{
  "name": "@oblivion/daily-life",
  "version": "0.0.1",
  "description": "有数 —— 家庭物品服役账本：记录买入/卖出、算真实日均成本与服役进度、复盘闲置损耗。Node 半边单文件 JSON 账本，浏览器半边是侧栏里的一页。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./testkit": "./lib/testkit.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compat": {
      "host": ">=0.2.0-rc.2 <0.3.0",
      "requires": {
        "slots": [
          "sidebar.footer.action"
        ],
        "slotKinds": {
          "sidebar.footer.action": "list"
        },
        "services": [
          "webServer"
        ],
        "npmPackages": [
          "dsh-better-sidebar"
        ],
        "clientContract": [
          "__ModuleLoader__"
        ]
      }
    }
  },
  "files": [
    "lib",
    "dsh.bundle.patch.yml",
    "dshx.yml",
    "README.md",
    "VERSION"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "selfcheck": "node scripts/selfcheck.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
